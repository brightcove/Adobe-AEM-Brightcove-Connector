<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">
    <filter root="/conf/brightcove" mode="update"/>
    <filter root="/conf/global" mode="merge"/>
    <filter root="/content/brightcovetools" mode="update"/>
    <!-- Default DAM integration folder (repoinit creates it with portable grammar; title, cq:conf
         and the Brightcove metadataSchema come from here). The mode is a Maven property,
         substituted per platform by ui.content/pom.xml:
           cloud   merge_properties: each of the three is written only when the folder does not
                   already have it, and an existing value is never changed.
           on-prem merge: an existing jcr:content is left exactly as it is (customer values kept,
                   but a folder that lacks metadataSchema does not get it); a missing node is
                   created with all three.
         ⚠️ On-prem must not use merge_properties: FileVault 3.2.8 on 6.5 SPs rejects it
         ("No enum constant ImportMode.MERGE_PROPERTIES", JCRVLT-255), so the package fails to
         install. Never "update" on either: it resets a customer's own title, cq:conf or schema
         on every install (every AEMaaCS deploy). Other properties on the node (e.g.
         processingProfile) are untouched in every mode.
         Context: current/docs/core-folder-sync.md "Default folder properties". -->
    <filter root="/content/dam/brightcove_assets/jcr:content" mode="${brightcove.damFolderFilterMode}"/>
    <filter root="/conf/global/settings/workflow/models/bc-sync-new-asset" mode="update"/>
    <filter root="/conf/global/settings/workflow/models/brightcove-delete-asset" mode="update"/>
    <filter root="/var/workflow" mode="merge"/>
    <filter root="/var/workflow/models" mode="merge"/>
    <filter root="/var/workflow/models/bc-sync-new-asset" mode="update"/>
    <filter root="/var/workflow/models/brightcove-delete-asset" mode="update"/>
    <!-- Legacy 6.0.x clientlib paths, owned here with NO content so an in-place upgrade
         removes them. ⚠️ Measured 2026-09-17 on :4602 by installing the real 6.0.12
         package over 7.3.7: it restored /etc/designs/cs/brightcove/players/html5-player
         as a registered client library serving 6250 bytes under the SAME category
         (brc.html5-player) as the new /apps library's 8598 bytes, so every page
         requesting that category loaded the old AND the new player JS. Nothing else
         deleted them, because both packages' /conf and /var filters are mode="merge"
         and neither owns /etc. Same pattern as the /apps/brightcove/install and
         /apps/brightcove/runmodes filters in ui.apps.
         Context: ONPREM-PARITY-PLAN.md §3 Phase 4 step 2, current/docs/onprem-upgrade-6.0-to-7.md.
         Categories: brc.html5-player, brc.smart-player and cq.shared all exist under
         /apps on this line; brc.bootstrap.v2 does not and is dropped (it belonged to
         the replaced 6.0.x admin console). -->
    <filter root="/etc/designs/cs/brightcove"/>
    <filter root="/etc/clientlibs/brightcove"/>
</workspaceFilter>
