<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.coresecure</groupId>
        <artifactId>brightcove</artifactId>
        <version>7.4.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- On-prem-only content. Built and embedded only under -Daem.platform=onprem (parent
         and all/ onprem profiles), so the cloud artifact never carries it: AEMaaCS has no
         classic replication agents to drive.
         Holds the "Brightcove Replication Agent" that 5.x - 6.0.12-prem shipped enabled, so
         DAM activation syncs to Video Cloud out of the box on-prem, as it always did.
         Context: ../docs/dam-sync-on-activation.md -->
    <artifactId>brightcove.ui.content.onprem</artifactId>
    <packaging>content-package</packaging>
    <name>Brightcove Connector - UI content (on-prem only)</name>
    <description>On-prem-only content for Brightcove Connector: the Brightcove replication agent</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <configuration>
                    <group>com.coresecure</group>
                    <name>brightcove.ui.content.onprem</name>
                    <packageType>content</packageType>
                    <validatorsSettings>
                        <jackrabbit-filter>
                            <options>
                                <validRoots>/etc/replication/agents.author</validRoots>
                            </options>
                        </jackrabbit-filter>
                    </validatorsSettings>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.day.jcr.vault</groupId>
                <artifactId>content-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <verbose>true</verbose>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
